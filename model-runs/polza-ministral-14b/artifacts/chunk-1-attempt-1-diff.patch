+// Константы порогов и ставок для негабаритных отправлений
+const LENGTH_THRESHOLD_CM = 120;
+const SUM_THRESHOLD_CM = 300;
+const SMALL_SURCHARGE_PERCENT = 40;
+const LARGE_SURCHARGE_PERCENT = 90;
+
+/**
+ * Рассчитывает надбавку за негабарит.
+ * @param longestSideCm - наибольшая сторона в сантиметрах
+ * @param dimensionSumCm - сумма всех измерений в сантиметрах
+ * @param base - базовая цена в копейках
+ * @returns надбавка в копейках или undefined, если отправление в пределах габаритов
+ */
+export function oversizeSurcharge(longestSideCm: number, dimensionSumCm: number, base: number): number | undefined {
+    // Если оба условия не выполнены, надбавка не начисляется
+    if (longestSideCm <= LENGTH_THRESHOLD_CM && dimensionSumCm <= SUM_THRESHOLD_CM) {
+        return undefined;
+    }
+    
+    // Если сумма измерений строго больше 300 см, применяется ставка 90%
+    if (dimensionSumCm > SUM_THRESHOLD_CM) {
+        return Math.round(base * LARGE_SURCHARGE_PERCENT / 100);
+    }
+    
+    // Если только наибольшая сторона строго больше 120 см, применяется ставка 40%
+    if (longestSideCm > LENGTH_THRESHOLD_CM) {
+        return Math.round(base * SMALL_SURCHARGE_PERCENT / 100);
+    }
+    
+    return undefined;
+}
