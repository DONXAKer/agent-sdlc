+/**
+ * Логика проверки негабаритности отправлений.
+ */
+
+import type { Dimensions } from './tariffs.ts';
+
+/**
+ * Проверка негабаритности отправления.
+ * @param dimensions Габариты отправления в сантиметрах.
+ * @returns true, если отправление негабаритное (сумма измерений > 300 см или наибольшая сторона > 120 см).
+ */
+export function isOversize(dimensions: Dimensions): boolean {
+  const longestSide = Math.max(dimensions[0], dimensions[1], dimensions[2]);
+  const dimensionSum = dimensions[0] + dimensions[1] + dimensions[2];
+  
+  return dimensionSum > 300 || longestSide > 120;
+}
+
+/**
+ * Расчет надбавки для негабаритных отправлений.
+ * @param basePrice Базовая цена зоны.
+ * @param dimensions Габариты отправления.
+ * @returns Надбавка в копейках.
+ */
+export function calculateSurcharge(basePrice: number, dimensions: Dimensions): number {
+  const isOversizeSum = dimensions.reduce((sum, dim) => sum + dim, 0) > 300;
+  const isOversizeSide = Math.max(dimensions[0], dimensions[1], dimensions[2]) > 120;
+  
+  if (isOversizeSum) {
+    return basePrice * 0.9; // 90% надбавка для суммы измерений > 300 см
+  } else if (isOversizeSide) {
+    return basePrice * 0.4; // 40% надбавка для наибольшей стороны > 120 см
+  }
+  
+  return 0; // Нет надбавки
+}
