{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sdlc.dev/schemas/review-evidence-v1.schema.json",
  "title": "Пакет первичных доказательств независимого ревью",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "files": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "claims", "kind", "source", "sha256", "revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^claim-[1-9][0-9]*$"}},
        "kind": {"enum": ["observation", "stdout", "screenshot", "sql_trace", "fixture"]},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "object", "additionalProperties": false, "required": ["head_sha", "diff_sha256"],
          "properties": {
            "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
            "diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    }}
  }
}
