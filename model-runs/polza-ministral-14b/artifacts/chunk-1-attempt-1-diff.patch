+import { priceFor } from '../src/tariffs.ts';
+import type { Quote } from '../src/tariffs.ts';
+import { zoneOf } from '../src/zones.ts';
+import { strict as assert } from 'node:assert';
+const { deepStrictEqual, ok } = assert;
+
+/**
+ * Фикстура для тестов: отправление с заданными параметрами.
+ * @param params - параметры заказа
+ * @returns объект заказа
+ */
+function order(params: {
+  regionCode?: number;
+  weightG?: number;
+  dimensionsCm?: [number, number, number];
+  customer?: 'none' | 'silver' | 'gold';
+} = {}) {
+  return {
+    regionCode: params.regionCode ?? 1, // Москва по умолчанию
+    weightG: params.weightG ?? 500,
+    dimensionsCm: params.dimensionsCm ?? [20, 15, 10],
+    customer: params.customer ?? 'none',
+  };
+}
+
+function runTests() {
+  function testClaim1() {
+    const quote = priceFor(order());
+    deepStrictEqual(Object.keys(quote).sort(), ['base', 'discount', 'total', 'zone']);
+    deepStrictEqual(quote, {
+      zone: zoneOf(1),
+      base: 19_900,
+      discount: 0,
+      total: 19_900,
+    });
+  });
+
+  function testClaim2() {
+    const quote = priceFor(order({ dimensionsCm: [130, 50, 50] }));
+    ok(quote.surcharge === 7_960); // 40% от 19_900
+    ok(quote.total === 27_860); // 19_900 + 7_960
+  });
+
+  function testClaim3() {
+    const quote = priceFor(order({ dimensionsCm: [100, 100, 101] }));
+    ok(quote.surcharge === undefined);
+  });
+
+  function testClaim4() {
+    const quote = priceFor(order({ dimensionsCm: [150, 100, 60] }));
+    ok(quote.surcharge === 17_910); // 90% от 19_900
+    ok(quote.total === 37_810); // 19_900 + 17_910
+  });
+
+  function testClaim5() {
+    const quote = priceFor(order({ dimensionsCm: [120, 100, 80] }));
+    ok(quote.surcharge === undefined);
+  });
+
+  function testClaim6() {
+    const quote = priceFor(order({
+      dimensionsCm: [130, 50, 50],
+      customer: 'gold'
+    }));
+    ok(quote.surcharge === 7_960); // 40% от 19_900
+    ok(quote.total === 27_860 - 1_990); // 19_900 + 7_960 - 10% скидка
+  });
+
+  function testClaim7() {
+    const quote = priceFor(order({
+      regionCode: 14, // Зона far
+      weightG: 300,
+      dimensionsCm: [150, 50, 50]
+    }));
+    ok(quote.surcharge === 43_980); // 90% от 48_925
+    ok(quote.total === 48_925 + 43_980); // Базовая цена far + надбавка
+  });
+});
